# Copy to .env.local and fill in the values for this environment.
DATABASE_URL=mysql://absensi:CHANGE_ME@localhost:3306/absensi
APP_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
APP_TIMEZONE=Asia/Jakarta

# Use local for development. Set to minio on the VPS.
STORAGE_DRIVER=local
STORAGE_ROOT=./storage

# Required credentials when STORAGE_DRIVER=minio.
MINIO_ENDPOINT=
MINIO_BUCKET=composite-absensi
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
